# Deployed, NON-SECRET config for project fetchit-437a0 (committed). Secrets live in Secret Manager
# (firebase functions:secrets:set) and, for the emulator only, in .env.local. Never put a secret here.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
FULFILLMENT_CONFIRM_AFTER_SECONDS=30
FULFILLMENT_SHIP_AFTER_SECONDS=120
FULFILLMENT_DELIVERY_DAYS=3
# Debug callables (advanceOrder, runMaintenance) stay off in production.
ALLOW_DEBUG=false
# Demo recording only: 1 keeps fetchItem + purchaseOffer warm (billed while idle). Back to 0 afterwards.
DEMO_MIN_INSTANCES=0
# App Check on callables: false while rolling out (tokens logged, not required); true once registered (DEPLOY.md).
ENFORCE_APP_CHECK=false
